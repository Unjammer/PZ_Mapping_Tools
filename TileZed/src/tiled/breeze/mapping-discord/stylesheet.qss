/*
 * Mapping Discord (B42)
 *
 * A small visual nod to the unofficial Project Zomboid Mapping Discord
 * infographics. The complete standalone theme is generated by placing these
 * refinements after a recolored Breeze Dark stylesheet.
 */

QWidget
{
    color: #eef2ef;
    background-color: #141c17;
    selection-background-color: #4e8f61;
    selection-color: #eef2ef;
}

QMainWindow,
QDialog,
QMessageBox
{
    background-color: #0a0f0c;
}

QMenuBar,
QMenu,
QToolBar,
QStatusBar,
QDockWidget
{
    background-color: #101712;
}

QMenuBar
{
    border-bottom: 0.04em solid #2f4537;
}

QMenuBar::item:selected,
QMenu::item:selected
{
    color: #eef2ef;
    background-color: #24452f;
}

QMenu::separator
{
    height: 0.04em;
    background-color: #2f4537;
    margin: 0.35em 0.7em;
}

QToolBar
{
    border: none;
    border-bottom: 0.04em solid #2f4537;
    spacing: 0.2em;
}

QStatusBar
{
    color: #9da9a1;
    border-top: 0.04em solid #2f4537;
}

QDockWidget
{
    border: 0.04em solid #2f4537;
}

QDockWidget::title
{
    color: #65c981;
    background-color: #101712;
    border-bottom: 0.04em solid #2f4537;
    padding: 0.35em;
}

QGroupBox
{
    border: 0.06em solid #354b3c;
    border-radius: 0.45em;
    margin-top: 0.8em;
    padding-top: 0.35em;
}

QGroupBox::title
{
    color: #65c981;
    subcontrol-origin: margin;
    left: 0.65em;
    padding: 0 0.3em;
}

QPushButton,
QToolButton
{
    background-color: #19231c;
    border: 0.06em solid #3d5244;
    border-radius: 0.3em;
    padding: 0.3em 0.65em;
}

QPushButton:hover,
QToolButton:hover
{
    background-color: #1d2b22;
    border-color: #65c981;
}

QPushButton:pressed,
QPushButton:checked,
QToolButton:pressed,
QToolButton:checked
{
    background-color: #24452f;
    border-color: #4e8f61;
}

QPushButton:default
{
    color: #eef2ef;
    background-color: #4e8f61;
    border-color: #65c981;
}

QPushButton:default:hover
{
    background-color: #57996a;
}

QPushButton:disabled,
QToolButton:disabled
{
    color: #657269;
    background-color: #101612;
    border-color: #2d3c32;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox
{
    color: #eef2ef;
    background-color: #0f1611;
    border: 0.06em solid #3d5244;
    border-radius: 0.25em;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus
{
    border-color: #65c981;
}

QAbstractItemView
{
    color: #eef2ef;
    background-color: #101712;
    alternate-background-color: #141c17;
    border: 0.04em solid #354b3c;
    border-radius: 0.2em;
    outline: none;
}

QAbstractItemView::item:hover
{
    background-color: #1d2b22;
}

QAbstractItemView::item:selected
{
    color: #eef2ef;
    background-color: #4e8f61;
}

QHeaderView::section
{
    color: #aeb8b1;
    background-color: #19231c;
    border-color: #354b3c;
    padding: 0.3em;
}

QHeaderView::section:hover
{
    color: #65c981;
    background-color: #1d2b22;
}

QTabWidget::pane
{
    border: 0.06em solid #354b3c;
    border-radius: 0.3em;
}

QTabBar::tab
{
    color: #9da9a1;
    background-color: #101712;
    border-color: #354b3c;
    padding: 0.4em 0.75em;
}

QTabBar::tab:hover
{
    color: #eef2ef;
    background-color: #1d2b22;
}

QTabBar::tab:selected
{
    color: #65c981;
    background-color: #141c17;
    border-top: 0.12em solid #65c981;
}

QProgressBar
{
    color: #eef2ef;
    background-color: #0f1611;
    border: 0.06em solid #354b3c;
    border-radius: 0.3em;
    text-align: center;
}

QProgressBar::chunk
{
    background-color: #4e8f61;
    border-radius: 0.2em;
}

QToolTip
{
    color: #eef2ef;
    background-color: #141c17;
    border: 0.06em solid #f1d24e;
    padding: 0.25em;
}

QWidget[mappingAccent="success"]
{
    color: #65c981;
}

QWidget[mappingAccent="warning"]
{
    color: #f1d24e;
}

QWidget[mappingAccent="danger"]
{
    color: #f06a67;
}

QWidget[mappingAccent="info"]
{
    color: #69aaff;
}
